# Copy this file to .env before running docker compose.
# Replace every placeholder value below — these are NOT safe defaults.

# Image to pull. GUARD_PROXY_IMAGE_TAG must match a published release tag,
# e.g. v0.1.0-beta.6. GUARD_PROXY_IMAGE_REPO only needs to change if you are
# pulling from a fork or a private mirror.
GUARD_PROXY_IMAGE_REPO=ghcr.io/bihius
GUARD_PROXY_IMAGE_TAG=v0.1.0-beta.6

POSTGRES_USER=guard_proxy
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=guard_proxy

# Generate with `openssl rand -hex 32` or similar. Rotating either secret
# invalidates existing sessions / the log-shipper's ingest auth. The backend
# refuses to start while these still hold the placeholder shipped here.
JWT_SECRET_KEY=replace-me-openssl-rand-hex-32
LOG_INGEST_SHARED_SECRET=replace-me-openssl-rand-hex-32

# JSON array of origins allowed to make cross-origin requests to the backend.
# Set this to the URL(s) you will access the admin UI from.
CORS_ORIGINS=["https://admin.example.com"]

# Mark the refresh-token cookie Secure (HTTPS only). Leave it off only while
# the admin UI is reached over plain HTTP; enable it once the UI is behind TLS,
# otherwise the long-lived refresh cookie travels in clear text.
# AUTH_REFRESH_COOKIE_SECURE=false

# Optional log-shipper tuning (defaults shown)
# SHIPPER_POLL_INTERVAL=1
# SHIPPER_BACKOFF_BASE=1
# SHIPPER_BACKOFF_MAX=30
# SHIPPER_REQUEST_TIMEOUT=5

# Number of days to keep log rows before the retention cleanup removes them.
# LOG_RETENTION_DAYS=30

# Log level of the generated Coraza SPOA configuration (debug, info, warn, error).
# CORAZA_LOG_LEVEL=info

# Size cap (bytes) for the Coraza audit log before the supervisor truncates it
# in place and keeps one backup. Default 256 MiB.
# CORAZA_AUDIT_LOG_MAX_BYTES=268435456

# GeoIP country filtering (issue #175)
# Free, no license key, no registration required. Database from ip66.dev,
# licensed CC BY 4.0, rebuilt daily upstream.
# GEOIP_DATABASE_URL=https://downloads.ip66.dev/db/ip66.mmdb
# GEOIP_REFRESH_INTERVAL_DAYS=1
# GEOIP_FAIL_OPEN=true

# Not read at container startup. The install guide's seed_admin.py step
# passes ADMIN_EMAIL/ADMIN_PASSWORD via `docker compose exec -e ...` instead
# of setting them here, so a plaintext admin password isn't left at rest —
# leave these commented out.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-generate-a-strong-password
# ADMIN_FULL_NAME=Administrator

# Ports HAProxy exposes on the host.
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443

# Port the admin UI is exposed on (host:container 8080, nginx).
FRONTEND_PORT=3000
