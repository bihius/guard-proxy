# Copy this file to .env before running docker compose (`make env` does that and
# generates both secrets below). The placeholders here are rejected at backend
# startup on purpose: a shipped example value must never end up in use.

POSTGRES_USER=guard_proxy
POSTGRES_PASSWORD=guard_proxy_dev_password
POSTGRES_DB=guard_proxy

# The backend DATABASE_URL is built by docker-compose.yml from POSTGRES_*.

# Generate by `openssl rand -hex 32` or similar.
JWT_SECRET_KEY=replace-me-openssl-rand-hex-32
LOG_INGEST_SHARED_SECRET=replace-me-openssl-rand-hex-32

# CORS_ORIGINS is a JSON array of origins that are allowed to make cross-origin requests 
# to the backend.

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional log-shipper tuning (defaults shown)
# SHIPPER_POLL_INTERVAL=1
# SHIPPER_BACKOFF_BASE=1
# SHIPPER_BACKOFF_MAX=30
# SHIPPER_REQUEST_TIMEOUT=5

# Number of days to keep log rows before the retention cleanup removes them.
# LOG_RETENTION_DAYS=30

# Log level of the generated Coraza SPOA configuration (debug, info, warn, error).
# CORAZA_LOG_LEVEL=info

# Size cap (bytes) for the Coraza audit log before the supervisor truncates it
# in place and keeps one backup. Default 256 MiB.
# CORAZA_AUDIT_LOG_MAX_BYTES=268435456

# GeoIP country filtering (issue #175)
# Free, no license key, no registration required. Database from ip66.dev,
# licensed CC BY 4.0, rebuilt daily upstream.
# GEOIP_DATABASE_URL=https://downloads.ip66.dev/db/ip66.mmdb
# GEOIP_REFRESH_INTERVAL_DAYS=1
# GEOIP_FAIL_OPEN=true

# ACME directory for the built-in Let's Encrypt certificate flow. Unset means
# Let's Encrypt production, certbot's own default. Point it at the staging
# directory, or at a local ACME server (e.g. Pebble), to exercise issuance
# without spending production rate limits. To trust the private CA of such a
# server, set REQUESTS_CA_BUNDLE to its PEM file — certbot reads that variable
# itself, no Guard Proxy setting needed.
# ACME_SERVER_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# Local admin seed used by `make seed` and the benchmark lab.
# Should be changed after initial deployment. 
# ADMIN_EMAIL=admin@domain.com
# ADMIN_PASSWORD=GuardProxyDemo12345
# ADMIN_FULL_NAME=Administrator

# Ports HAProxy exposes to the host machine.
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443

# Port the admin UI is exposed on (host:container 8080, nginx).
FRONTEND_PORT=3000
