# Copy to benchmarks/lab/.env before running the eval lab.
# These are local-lab defaults only -- never use these credentials in production.

# --- WordPress database -----------------------------------------------------
WP_DB_ROOT_PASSWORD=wp_root_pw
WP_DB_PASSWORD=wp_pw
WP_ADMIN_PASSWORD=LabAdmin12345!

# --- Lab policy profiles (used by setup-lab.sh and set-policy.sh) ------------
# Every lab vhost gets its own policy, named "Lab <domain>". A profile is the
# set of settings `make set-policy POLICY=pl1|pl2 [TARGET_VHOST=...]` writes
# into those policies.
#
# pl1 (baseline, applied by setup-lab.sh): PL1, anomaly threshold 5, block mode
LAB_POLICY_PARANOIA=1
LAB_POLICY_INBOUND_THRESHOLD=5
LAB_POLICY_OUTBOUND_THRESHOLD=4

# pl2 (paranoia sweep): PL2, same thresholds as pl1, block mode. Only the
# paranoia level differs, so PL1 vs PL2 results isolate its effect.
LAB_PL2_POLICY_PARANOIA=2
LAB_PL2_POLICY_INBOUND_THRESHOLD=5
LAB_PL2_POLICY_OUTBOUND_THRESHOLD=4

# --- CPU pinning (optional) -------------------------------------------------
# Pin the WAF stack + targets to one core range, and load-generator/test
# containers to a separate range, to reduce noisy-neighbour contention on
# shared hosts. Leave empty (default) for no pinning -- required on hosts
# with fewer cores than the ranges below, or when running outside a
# dedicated lab host.
# Example used for the thesis lab (24-core host):
#   LAB_WAF_CPUSET=18-20
#   LAB_ATTACKER_CPUSET=21-23
LAB_WAF_CPUSET=
LAB_ATTACKER_CPUSET=

# --- Vhost domains -----------------------------------------------------------
# ftw.local: Albedo, target of go-ftw (CRS regression) and wrk (overhead).
LAB_FTW_DOMAIN=ftw.local
LAB_FTW_BACKEND_URL=http://ftw-backend:8080

# wp.local: WordPress, target of the tagged benign/attack corpus.
LAB_WP_DOMAIN=wp.local
LAB_WP_BACKEND_URL=http://wordpress:80
