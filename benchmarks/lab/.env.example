# Copy to benchmarks/lab/.env before running the eval lab.
# These are local-lab defaults only -- never use these credentials in production.

# --- WordPress database -----------------------------------------------------
WP_DB_ROOT_PASSWORD=wp_root_pw
WP_DB_PASSWORD=wp_pw
WP_ADMIN_PASSWORD=LabAdmin12345!

# --- Lab policy profiles -------------------------------------------------------
# Every lab vhost gets its own policy, named "Lab <domain>".
# `make set-policy POLICY=pl1|pl2` writes a profile into those policies:
#   pl1: paranoia 1, inbound threshold 5, outbound threshold 4, block mode
#   pl2: paranoia 2, inbound threshold 5, outbound threshold 4, block mode
# Both with rate limiting and GeoIP off and no exclusions. The profiles are
# fixed in policy-profiles.sh so that they differ only in paranoia level; do
# not set LAB_POLICY_* or LAB_PL2_POLICY_* here (set-policy refuses values
# that differ from the fixed profiles).

# --- CPU pinning (optional) -------------------------------------------------
# Reserve CPUs for the WAF stack and targets only when the host topology
# and concurrent workloads permit it. Leave both sets empty by default.
LAB_WAF_CPUSET=
LAB_ATTACKER_CPUSET=

# --- Vhost domains -----------------------------------------------------------
# ftw.local: Albedo, target of go-ftw (CRS regression) and wrk (overhead).
LAB_FTW_DOMAIN=ftw.local
LAB_FTW_BACKEND_URL=http://ftw-backend:8080

# Address of the lab server as the separate load client sees it (e.g. its VPN
# address 10.99.99.20). Albedo's port that bypasses HAProxy (direct path of the
# load test) is published on this address, and LOAD_CLIENT=manual builds the
# wrk URLs from it. Keep 127.0.0.1 for single-machine runs.
LAB_SERVER_ADDR=127.0.0.1
LAB_FTW_DIRECT_PORT=18080

# wp.local: WordPress, target of the tagged benign/attack corpus.
LAB_WP_DOMAIN=wp.local
LAB_WP_BACKEND_URL=http://wordpress:80
